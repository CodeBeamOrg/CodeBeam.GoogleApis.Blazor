<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>0.3.1</Version>
    <PackageIcon>CodeBeam.jpg</PackageIcon>
    <Copyright>Copyright 2026 CodeBeam</Copyright>
    <Description>A utility package for Google Apis in Blazor.</Description>
    <RepositoryUrl>https://github.com/CodeBeamOrg/CodeBeam.GoogleApis.Blazor</RepositoryUrl>
    <PackageProjectUrl>https://github.com/CodeBeamOrg/CodeBeam.GoogleApis.Blazor</PackageProjectUrl>
    <PackageTags>blazor;google;api;auth;calendar</PackageTags>
    <Company>CodeBeam</Company>
    <Authors>CodeBeam</Authors>
    <PackageId>CodeBeam.GoogleApis.Blazor</PackageId>
    <Product>CodeBeam.GoogleApis.Blazor</Product>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

	<ItemGroup>
		<None Include="CodeBeam.jpg" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- .NET 6 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components" Version="6.0.36" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="6.0.1" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="6.0.0" />
		<PackageReference Include="Microsoft.JSInterop" Version="6.0.36" />
	</ItemGroup>

	<!-- .NET 7 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net7.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components" Version="7.0.20" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="7.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="7.0.0" />
		<PackageReference Include="Microsoft.JSInterop" Version="7.0.20" />
	</ItemGroup>

	<!-- .NET 8 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
		<PackageReference Include="Microsoft.JSInterop" Version="8.0.0" />
	</ItemGroup>

	<!-- .NET 9 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components" Version="9.0.5" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.5" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.5" />
		<PackageReference Include="Microsoft.JSInterop" Version="9.0.5" />
	</ItemGroup>

	<!-- .NET 10 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<PackageReference Include="Microsoft.JSInterop" Version="10.0.0" />
	</ItemGroup>

</Project>
